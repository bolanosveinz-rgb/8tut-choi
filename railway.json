{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build --workspace=@assistrep/shared && npm run build --workspace=@assistrep/api"
  },
  "deploy": {
    "startCommand": "npm run start --workspace=@assistrep/api",
    "healthcheckPath": "/api/v1/health",
    "healthcheckTimeout": 100
  }
}
