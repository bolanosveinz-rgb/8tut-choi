# Local development only. Copy to .env and replace these values before starting Docker.
MYSQL_DATABASE=assistrep
MYSQL_USER=assistrep
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
MYSQL_PORT=3306
REDIS_PORT=6379

DATABASE_URL=mysql://assistrep:replace-with-a-local-password@127.0.0.1:3306/assistrep
REDIS_URL=redis://127.0.0.1:6379
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Add production credentials only to the deployment provider's secret manager.

